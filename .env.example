# Neon Postgres connection strings (Neon console -> Connect).
# App runtime: the pooled connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Migrations (drizzle-kit): the direct connection string (same host without "-pooler").
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app
BETTER_AUTH_URL="http://localhost:3000"
